---
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import Icon from '../components/Icon.astro';
import GhlForm from '../components/GhlForm.astro';
import { BRAND, GHL } from '../data/site';
---
<Base
  title="Request Residential HVAC Service | Dent's Heating And Cooling"
  description="Request heating or cooling service for your home in St. Louis or North County. Gerald will follow up to schedule. Or call 314-420-7803."
>
  <PhotoHero
    title="Request service for your home"
    lead="Tell Gerald about the system and the problem. He'll follow up to set a time."
    img="/photos/hero-home.webp"
    alt="A red-brick St. Louis bungalow with an outdoor air conditioning unit"
    crumb="Request service"
    accent="heat"
  >
    <a class="btn btn-red btn-lg" href={BRAND.phoneHref}><Icon name="phone" /> Can't wait? Call {BRAND.phone}</a>
  </PhotoHero>
  <section class="section form-wrap">
    <div class="wrap narrow">
      <h2>Your service request</h2>
      <GhlForm form={GHL.forms.residential} />
    </div>
  </section>
</Base>
<style>
  .form-wrap {
    background: var(--wash);
  }
  .narrow {
    max-width: 860px;
  }
  h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    margin-bottom: 1.25rem;
  }
  .btn-lg {
    min-height: 60px;
    padding-inline: 1.6rem;
    font-size: 1.05rem;
  }
</style>
