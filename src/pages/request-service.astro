---
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
import GhlForm from '../components/GhlForm.astro';
import { GHL } from '../data/site';
---
<Base
  title="Request Residential HVAC Service | Dent's Heating And Cooling"
  description="Request heating or cooling service for your home in St. Louis or North County. Gerald will follow up to schedule. Or call (314) 420-7803."
>
  <PageBand title="Request service for your home" lead="Tell Gerald about the system and the problem. He'll follow up to set a time. Can't wait? Call (314) 420-7803." tone="heat" />
  <section class="section form-wrap">
    <div class="wrap narrow"><GhlForm form={GHL.forms.residential} /></div>
  </section>
</Base>
<style>
  .form-wrap {
    background: var(--wash);
  }
  .narrow {
    max-width: 860px;
  }
</style>
