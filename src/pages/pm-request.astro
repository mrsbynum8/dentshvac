---
import Base from '../layouts/Base.astro';
import FormPage from '../components/FormPage.astro';
import { GHL } from '../data/site';
---
<Base
  title="Property Management HVAC Request | Dent's Heating And Cooling"
  description="Property managers: send an HVAC service request for a unit or building in St. Louis. Gerald diagnoses and fixes it himself."
>
  <FormPage
    title="Property service request"
    lead="Send the property, the unit and the issue. Gerald diagnoses it and schedules the work with your office."
    img="/photos/apartments.webp"
    alt="A brick apartment building with a row of outdoor air conditioning units"
    crumb="Property request"
    form={GHL.forms.property}
    points={[
      { icon: 'building', t: 'Apartments, multifamily and rentals' },
      { icon: 'wrench', t: 'The owner on every call' },
      { icon: 'calendar', t: 'Seasonal maintenance across a property' },
    ]}
    call="Call or text"
  />
</Base>
