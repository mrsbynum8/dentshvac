---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import QuoteCard from '../components/QuoteCard.astro';
import { BRAND, GOOGLE, SERVICES, FAQS } from '../data/site';

const heating = SERVICES.find((s) => s.slug === 'heating')!;
const cooling = SERVICES.find((s) => s.slug === 'cooling')!;
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Dent's Heating And Cooling | Furnace & AC Repair in St. Louis"
  description="No heat? No AC? Call Gerald Pickett, the owner of Dent's Heating And Cooling, for furnace and AC repair, installs and tune-ups in St. Louis and North County. (314) 420-7803."
  schema={[faqSchema]}
>
  
  <section class="hero" aria-labelledby="hero-title">
    <picture class="hero-photo">
      <source media="(max-width: 767px)" srcset="/photos/hero-home-900.webp" />
      <img
        src="/photos/hero-home.webp"
        alt="A red-brick St. Louis bungalow with an outdoor air conditioning unit beside the porch"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-copy">
      <h1 id="hero-title">Heating and AC repair in St.&nbsp;Louis, <span class="hero-hl">from the owner himself.</span></h1>
      <p class="hero-sub">No heat or no AC? Gerald Pickett answers, diagnoses your system, and does the work, for homes and property managers across St. Louis and North County.</p>
      <div class="hero-actions">
        <a class="btn btn-red btn-lg" href={BRAND.phoneHref}><Icon name="phone" /> Call {BRAND.phone}</a>
        <a class="btn btn-line btn-lg" href="/services/property-management">Property managers</a>
      </div>
    </div>
    <div class="hero-form" id="request">
      <QuoteCard id="hero" />
    </div>
  </section>

  <section class="trust" aria-label="Why people call Dent's">
    <ul class="wrap trust-list">
      <li><Icon name="check" /><div><p class="t-h">The owner does the work</p><p class="t-s">No sales team, no hand-offs.</p></div></li>
      <li><Icon name="check" /><div><p class="t-h">Price before any work</p><p class="t-s">Checked at today's supplier cost.</p></div></li>
      <li><Icon name="check" /><div><p class="t-h">Homes and multifamily</p><p class="t-s">Residential, apartments and rentals.</p></div></li>
    </ul>
  </section>

  <a class="pm-bar" href="/services/property-management">
    <span class="pm-bar-in">
      <strong>Property manager or landlord?</strong>
      <span>Units down across a building? Send the property and the unit, and Gerald will take it from there.</span>
      <span class="pm-go">Property service <Icon name="arrow" /></span>
    </span>
  </a>

  <section class="owner section">
    <div class="wrap owner-grid">
      <div class="owner-copy">
        <h2>One owner. He picks up, and he does the work.</h2>
        <p>
          Dent's Heating And Cooling is {BRAND.owner}. When you call, you're talking to the person who will diagnose your system and
          fix it: no sales team, no hand-offs, no upsell script. If he's mid-job, the line takes your details so the call never goes to
          voicemail.
        </p>
        <p>He works on homes across {BRAND.area}, and on apartment and multifamily properties for the managers who run them.</p>
        <a class="link-arrow" href="/about">More about Gerald <Icon name="arrow" /></a>
      </div>
      <ol class="visit">
        <li>
          <h3>You call or send a request</h3>
          <p>Tell Gerald what the system is doing. Texting the details works too.</p>
        </li>
        <li>
          <h3>Gerald comes out and finds the problem</h3>
          <p>A proper diagnosis first, so you pay for the fix you need.</p>
        </li>
        <li>
          <h3>You get the price before any work</h3>
          <p>Part prices move, so he checks today's supplier cost and calls you with the number.</p>
        </li>
        <li>
          <h3>It gets fixed, start to finish</h3>
          <p>Gerald does the repair himself, so the person who found the problem is the one who fixes it.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="svc" aria-labelledby="svc-h">
    <h2 id="svc-h" class="sr-only">Services</h2>
    <div class="svc-col svc-heat">
      <div class="svc-in">
        <h3><a href="/services/heating">Heating</a></h3>
        <ul>{heating.covers.slice(0, 5).map((c) => <li>{c}</li>)}</ul>
        <a class="link-arrow" href="/services/heating">All heating services <Icon name="arrow" /></a>
      </div>
    </div>
    <div class="svc-col svc-cool">
      <div class="svc-in">
        <h3><a href="/services/cooling">Cooling</a></h3>
        <ul>{cooling.covers.slice(0, 5).map((c) => <li>{c}</li>)}</ul>
        <a class="link-arrow" href="/services/cooling">All cooling services <Icon name="arrow" /></a>
      </div>
    </div>
    <div class="svc-wide">
      <div class="wrap svc-wide-in">
        <div>
          <h3><a href="/services/maintenance">Tune-ups before each season</a></h3>
          <p>A spring AC check and a fall furnace check catch the cheap problems before they become the expensive ones. You'll get a reminder every spring.</p>
        </div>
        <a class="btn btn-line" href="/services/maintenance">Book a tune-up <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="reviews section">
    <div class="wrap reviews-in">
      <div class="stars" aria-hidden="true">
        <Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" />
      </div>
      <h2>Hear it from his customers</h2>
      <p>Real reviews live on Google, where nobody can edit them but the people who wrote them.</p>
      <div class="reviews-act">
        <a class="btn btn-navy" href={GOOGLE.reviewsUrl} target="_blank" rel="noopener">Read Google reviews <Icon name="arrow" /></a>
        <a class="btn btn-line" href={GOOGLE.writeReviewUrl} target="_blank" rel="noopener">Worked with Gerald? Leave a review</a>
      </div>
    </div>
  </section>

  <section class="callband">
    <div class="wrap callband-in">
      <h2>No heat or no AC right now?</h2>
      <a class="btn btn-white btn-lg" href={BRAND.phoneHref}><Icon name="phone" /> Call {BRAND.phone}</a>
    </div>
  </section>

  <section class="faq section">
    <div class="wrap faq-grid">
      <h2>Straight answers</h2>
      <div class="faq-list">
        {FAQS.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero: copy left, photo right, quote card over it ---------- */
  .hero {
    position: relative;
    background: var(--white);
    overflow: hidden;
  }
  .hero-photo {
    display: block;
    aspect-ratio: 16 / 10;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }
  .hero-copy {
    position: relative;
    padding: 1.75rem var(--gutter) 0.5rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 3.6vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .hero-hl {
    color: var(--red);
  }
  .hero-sub {
    margin-top: clamp(1.1rem, 1.6vw, 1.6rem);
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.4rem, 2vw, 2rem);
  }
  .btn-lg {
    min-height: 60px;
    padding-inline: 1.6rem;
    font-size: 1.05rem;
  }
  .hero-form {
    padding: 1.5rem var(--gutter) 2.25rem;
  }
  .hero-form :global(.qc) {
    border: 2px solid var(--line);
  }
  @media (min-width: 960px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(380px, 31vw, 460px);
      gap: clamp(2rem, 4vw, 4.5rem);
      align-items: center;
      padding: clamp(2.5rem, 3.6vw, 3.75rem) var(--gutter);
      min-height: calc(100svh - var(--header-h) - 64px);
    }
    .hero-photo {
      position: absolute;
      inset: 0 0 0 auto;
      width: 68%;
      aspect-ratio: auto;
      -webkit-mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 0.35) 16%, #000 40%);
      mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 0.35) 16%, #000 40%);
    }
    .hero-photo img {
      object-position: 62% center;
    }
    .hero-copy {
      padding: 0;
      max-width: 600px;
      z-index: 1;
    }
    .hero-form {
      padding: 0;
      z-index: 1;
    }
    .hero-form :global(.qc) {
      border: 0;
      box-shadow: 0 30px 60px -24px rgb(16 35 63 / 0.55);
    }
  }
  @media (min-width: 960px) and (max-width: 1179px) {
    .hero-photo {
      width: 58%;
    }
  }
  @media (min-width: 1600px) {
    .hero {
      padding-inline: calc((100vw - 1500px) / 2);
    }
  }

  /* ---------- Trust strip ---------- */
  .trust {
    background: var(--wash);
    border-top: 1px solid var(--line);
  }
  .trust-list {
    list-style: none;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding-block: 1.6rem;
  }
  .trust li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }
  .trust li :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--blue);
  }
  .trust li:first-child :global(svg) {
    color: var(--red);
  }
  .t-h {
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: 1.02rem;
  }
  .t-s {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  /* ---------- Property manager lane ---------- */
  .pm-bar {
    display: block;
    background: var(--navy);
    color: var(--white);
    text-decoration: none;
  }
  .pm-bar-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.25rem;
    max-width: 1440px;
    margin-inline: auto;
    min-height: 64px;
    padding: 0.9rem var(--gutter);
  }
  .pm-bar strong {
    font-stretch: var(--wide);
    font-weight: 800;
  }
  .pm-bar-in > span:not(.pm-go) {
    color: #c9d6e8;
  }
  .pm-go {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .pm-go :global(svg) {
    width: 1.05em;
    height: 1.05em;
    transition: transform 0.3s var(--ease);
  }
  .pm-bar:hover .pm-go :global(svg) {
    transform: translateX(4px);
  }

  /* ---------- Owner ---------- */
  .owner-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .owner h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    margin-bottom: 1.5rem;
  }
  .owner-copy p {
    color: var(--ink-soft);
    font-size: 1.125rem;
    margin-bottom: 1.1rem;
  }
  .owner-copy .link-arrow {
    margin-top: 0.5rem;
  }
  .visit {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: visit;
    border-top: 3px solid var(--navy);
  }
  .visit li {
    counter-increment: visit;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    column-gap: 1rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line);
  }
  .visit li::before {
    content: counter(visit);
    grid-row: span 2;
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    color: var(--red);
  }
  .visit li:nth-child(even)::before {
    color: var(--blue);
  }
  .visit h3 {
    font-size: 1.15rem;
    line-height: 1.25;
    margin-bottom: 0.35rem;
  }
  .visit p {
    color: var(--ink-soft);
  }

  /* ---------- Services split ---------- */
  .svc {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .svc-col {
    color: var(--white);
  }
  .svc-heat {
    background: var(--red);
  }
  .svc-cool {
    background: var(--blue);
  }
  .svc-in {
    padding: var(--section) clamp(1.5rem, 4.5vw, 4.5rem);
    max-width: 640px;
  }
  .svc-heat .svc-in {
    margin-left: auto;
  }
  .svc h3 {
    font-size: clamp(2.25rem, 4.2vw, 3.75rem);
    margin-bottom: 1.75rem;
  }
  .svc h3 a {
    text-decoration: none;
  }
  .svc ul {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    border-top: 1px solid rgb(255 255 255 / 0.35);
  }
  .svc li {
    padding: 0.85rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.35);
    font-size: 1.02rem;
  }
  .svc-heat li {
    color: var(--white);
  }
  .svc-cool li {
    color: var(--white);
  }
  .svc-col .link-arrow {
    color: var(--white);
  }
  .svc-wide {
    grid-column: 1 / -1;
    background: var(--wash);
  }
  .svc-wide-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
  }
  .svc-wide h3 {
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    margin-bottom: 0.6rem;
    color: var(--ink);
  }
  .svc-wide p {
    color: var(--ink-soft);
    max-width: 44rem;
  }

  /* ---------- Reviews ---------- */
  .reviews-in {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
  }
  .stars {
    display: flex;
    gap: 0.3rem;
    color: var(--red);
  }
  .stars :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
  }
  .reviews h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
  }
  .reviews p {
    color: var(--ink-soft);
    font-size: 1.125rem;
    max-width: 36rem;
  }
  .reviews-act {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  /* ---------- Call band ---------- */
  .callband {
    background: linear-gradient(90deg, var(--red) 0 50%, var(--blue) 50% 100%);
    color: var(--white);
  }
  .callband-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
  }
  .callband h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.75rem);
  }
  .btn-white {
    background: var(--white);
    color: var(--navy);
    font-variant-numeric: tabular-nums;
  }
  .btn-white:hover {
    background: var(--navy);
    color: var(--white);
  }

  /* ---------- FAQ ---------- */
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .faq h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
  }
  .faq-list {
    border-top: 3px solid var(--navy);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-weight: 750;
    font-size: 1.1rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--red);
    transition: rotate 0.3s var(--ease);
  }
  details[open] summary::after {
    rotate: 45deg;
  }
  details p {
    padding: 0 0 1.4rem;
    color: var(--ink-soft);
    max-width: 44rem;
  }

  /* ---------- Small screens ---------- */
  @media (max-width: 960px) {
    .owner-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .trust-list {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .hero-actions .btn {
      width: 100%;
    }
    .callband {
      background: var(--red);
    }
    .callband .btn {
      width: 100%;
    }
    .pm-go {
      margin-left: 0;
    }
    .svc {
      grid-template-columns: 1fr;
    }
    .svc-in {
      max-width: none;
    }
  }
</style>
