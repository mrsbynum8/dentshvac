---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import QuoteCard from '../components/QuoteCard.astro';
import CallBand from '../components/CallBand.astro';
import { BRAND, GOOGLE, SERVICES, FAQS } from '../data/site';

type IconName = 'flame' | 'thermometer' | 'fan' | 'zap' | 'house' | 'wind' | 'snowflake' | 'gauge' | 'droplets' | 'vent';
const panels: { tone: string; title: string; href: string; icon: IconName; img: string; alt: string; items: { icon: IconName; t: string; d: string }[] }[] = [
  {
    tone: 'heat', title: 'Heating', href: '/services/heating', icon: 'flame',
    img: '/photos/furnace.webp', alt: 'A modern gas furnace with vent pipes and ductwork in a basement',
    items: [
      { icon: 'flame', t: 'Furnace repair', d: 'Control boards, pressure switches, blower motors' },
      { icon: 'zap', t: 'Ignition problems', d: 'Flame sensors cleaned, igniters checked' },
      { icon: 'house', t: 'Furnace replacement', d: '60,000 to 100,000 BTU, permit pulled' },
      { icon: 'fan', t: 'Heat pumps', d: 'Service and installation' },
      { icon: 'thermometer', t: 'Thermostats', d: 'New installs and wiring conversions' },
    ],
  },
  {
    tone: 'cool', title: 'Cooling', href: '/services/cooling', icon: 'snowflake',
    img: '/photos/ac.webp', alt: 'An outdoor air conditioning condenser beside a red-brick house',
    items: [
      { icon: 'snowflake', t: 'AC repair', d: 'Capacitors, contactors, condenser fan motors' },
      { icon: 'droplets', t: 'Leak checks', d: 'Refrigerant leak diagnostics and inspections' },
      { icon: 'gauge', t: 'Refrigerant service', d: 'R-410A and R-454B systems' },
      { icon: 'vent', t: 'New AC systems', d: 'Condensers (2 to 4 ton), coils and line sets' },
      { icon: 'wind', t: 'Air handlers', d: 'Blowers, A-coils and filter racks' },
    ],
  },
];
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Dent's Heating And Cooling | Furnace & AC Repair in St. Louis"
  description="No heat? No AC? Call Gerald Pickett, the owner of Dent's Heating And Cooling, for furnace and AC repair, installs and tune-ups in St. Louis and North County. 314-420-7803."
  schema={[faqSchema]}
>
  
  <section class="hero" aria-labelledby="hero-title">
    <picture class="hero-photo">
      <source media="(max-width: 767px)" srcset="/photos/hero-home-900.webp" />
      <img
        src="/photos/hero-home.webp"
        alt="A red-brick St. Louis bungalow with an outdoor air conditioning unit beside the porch"
        width="1536"
        height="1024"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-copy">
      <h1 id="hero-title">Heating and AC repair in St.&nbsp;Louis, <span class="hero-hl">from the owner himself.</span></h1>
      <p class="hero-sub">No heat or no AC? Gerald Pickett answers, diagnoses your system, and does the work, for homes and property managers across St. Louis and North County.</p>
      <div class="hero-actions">
        <a class="btn btn-red btn-lg" href={BRAND.phoneHref}><Icon name="phone" /> Call {BRAND.phone}</a>
        <a class="btn btn-line btn-lg" href="/services/property-management">Property managers</a>
      </div>
    </div>
    <div class="hero-form" id="request">
      <QuoteCard id="hero" />
    </div>
  </section>

  <section class="trust" aria-label="Why people call Dent's">
    <ul class="wrap trust-list">
      <li><Icon name="check" /><div><p class="t-h">The owner does the work</p><p class="t-s">No sales team, no hand-offs.</p></div></li>
      <li><Icon name="check" /><div><p class="t-h">Price before any work</p><p class="t-s">Checked at today's supplier cost.</p></div></li>
      <li><Icon name="check" /><div><p class="t-h">Homes and multifamily</p><p class="t-s">Residential, apartments and rentals.</p></div></li>
    </ul>
  </section>

  <a class="pm-bar" href="/services/property-management">
    <span class="pm-bar-in">
      <strong>Property manager or landlord?</strong>
      <span>Units down across a building? Send the property and the unit, and Gerald will take it from there.</span>
      <span class="pm-go">Property service <Icon name="arrow" /></span>
    </span>
  </a>

  <section class="owner section">
    <div class="wrap owner-grid">
      <div class="owner-copy">
        <h2>One owner. He picks up, and he does the work.</h2>
        <p>
          Dent's Heating And Cooling is {BRAND.owner}. When you call, you're talking to the person who will diagnose your system and
          fix it: no sales team, no hand-offs, no upsell script. If he's mid-job, the line takes your details so the call never goes to
          voicemail.
        </p>
        <p>He works on homes across {BRAND.area}, and on apartment and multifamily properties for the managers who run them.</p>
        <a class="link-arrow" href="/about">More about Gerald <Icon name="arrow" /></a>
      </div>
      <ol class="visit">
        <li>
          <h3>You call or send a request</h3>
          <p>Tell Gerald what the system is doing. Texting the details works too.</p>
        </li>
        <li>
          <h3>Gerald comes out and finds the problem</h3>
          <p>A proper diagnosis first, so you pay for the fix you need.</p>
        </li>
        <li>
          <h3>You get the price before any work</h3>
          <p>Part prices move, so he checks today's supplier cost and calls you with the number.</p>
        </li>
        <li>
          <h3>It gets fixed, start to finish</h3>
          <p>Gerald does the repair himself, so the person who found the problem is the one who fixes it.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="svc section" aria-labelledby="svc-h">
    <div class="wrap">
      <h2 id="svc-h" class="svc-title">What Gerald works on</h2>
      <div class="svc-grid">
        {panels.map((pn) => (
          <article class={`svc-panel svc-${pn.tone}`}>
            <div class="svc-photo">
              <img src={pn.img} alt={pn.alt} width="1536" height="1024" loading="lazy" />
            </div>
            <div class="svc-head">
              <Icon name={pn.icon} />
              <h3><a href={pn.href}>{pn.title}</a></h3>
            </div>
            <ul class="svc-items">
              {pn.items.map((it) => (
                <li>
                  <span class="svc-ico"><Icon name={it.icon} /></span>
                  <span><strong>{it.t}</strong>{it.d}</span>
                </li>
              ))}
            </ul>
            <a class="svc-more" href={pn.href}>All {pn.title.toLowerCase()} services <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
      <div class="svc-wide">
        <span class="svc-wide-ico"><Icon name="calendar" /></span>
        <div>
          <h3><a href="/services/maintenance">Tune-ups before each season</a></h3>
          <p>A spring AC check and a fall furnace check catch the cheap problems before they become the expensive ones. You'll get a reminder every spring.</p>
        </div>
        <a class="btn btn-line" href="/services/maintenance">Book a tune-up <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="reviews section">
    <div class="wrap reviews-in">
      <h2>Hear it from his customers</h2>
      <p>Real reviews live on Google, where nobody can edit them but the people who wrote them.</p>
      <div class="reviews-act">
        <a class="btn btn-navy" href={GOOGLE.reviewsUrl} target="_blank" rel="noopener">Read Google reviews <Icon name="arrow" /></a>
        <a class="btn btn-line" href={GOOGLE.writeReviewUrl} target="_blank" rel="noopener">Worked with Gerald? Leave a review</a>
      </div>
    </div>
  </section>

  <CallBand />

  <section class="faq section">
    <div class="wrap faq-grid">
      <h2>Straight answers</h2>
      <div class="faq-list">
        {FAQS.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero: copy left, photo right, quote card over it ---------- */
  .hero {
    position: relative;
    background: var(--white);
    overflow: hidden;
  }
  .hero-photo {
    display: block;
    aspect-ratio: 16 / 10;
  }
  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }
  .hero-copy {
    position: relative;
    padding: 1.75rem var(--gutter) 0.5rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 3.6vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .hero-hl {
    color: var(--red);
  }
  .hero-sub {
    margin-top: clamp(1.1rem, 1.6vw, 1.6rem);
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.4rem, 2vw, 2rem);
  }
  .btn-lg {
    min-height: 60px;
    padding-inline: 1.6rem;
    font-size: 1.05rem;
  }
  .hero-form {
    padding: 1.5rem var(--gutter) 2.25rem;
  }
  .hero-form :global(.qc) {
    border: 2px solid var(--line);
  }
  @media (min-width: 960px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(380px, 31vw, 460px);
      gap: clamp(2rem, 4vw, 4.5rem);
      align-items: center;
      padding: clamp(2.5rem, 3.6vw, 3.75rem) var(--gutter);
      min-height: calc(100svh - var(--header-h) - 64px);
    }
    .hero-photo {
      position: absolute;
      inset: 0 0 0 auto;
      width: 68%;
      aspect-ratio: auto;
      -webkit-mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 0.35) 16%, #000 40%);
      mask-image: linear-gradient(to right, transparent 0, rgb(0 0 0 / 0.35) 16%, #000 40%);
    }
    .hero-photo img {
      object-position: 62% center;
    }
    .hero-copy {
      padding: 0;
      max-width: 600px;
      z-index: 1;
    }
    .hero-form {
      padding: 0;
      z-index: 1;
    }
    .hero-form :global(.qc) {
      border: 0;
      box-shadow: 0 30px 60px -24px rgb(16 35 63 / 0.55);
    }
  }
  @media (min-width: 960px) and (max-width: 1179px) {
    .hero-photo {
      width: 58%;
    }
  }
  @media (min-width: 1600px) {
    .hero {
      padding-inline: calc((100vw - 1500px) / 2);
    }
  }

  /* ---------- Trust strip ---------- */
  .trust {
    background: var(--wash);
    border-top: 1px solid var(--line);
  }
  .trust-list {
    list-style: none;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding-block: 1.6rem;
  }
  .trust li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: start;
  }
  .trust li :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--blue);
  }
  .trust li:first-child :global(svg) {
    color: var(--red);
  }
  .t-h {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.02rem;
  }
  .t-s {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  /* ---------- Property manager lane ---------- */
  .pm-bar {
    display: block;
    background: var(--navy);
    color: var(--white);
    text-decoration: none;
  }
  .pm-bar-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.25rem;
    max-width: 1440px;
    margin-inline: auto;
    min-height: 64px;
    padding: 0.9rem var(--gutter);
  }
  .pm-bar strong {
    font-family: var(--display);
    font-weight: 700;
  }
  .pm-bar-in > span:not(.pm-go) {
    color: #c9d6e8;
  }
  .pm-go {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .pm-go :global(svg) {
    width: 1.05em;
    height: 1.05em;
    transition: transform 0.3s var(--ease);
  }
  .pm-bar:hover .pm-go :global(svg) {
    transform: translateX(4px);
  }

  /* ---------- Owner ---------- */
  .owner-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .owner h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    margin-bottom: 1.5rem;
  }
  .owner-copy p {
    color: var(--ink-soft);
    font-size: 1.125rem;
    margin-bottom: 1.1rem;
  }
  .owner-copy .link-arrow {
    margin-top: 0.5rem;
  }
  .visit {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: visit;
    border-top: 3px solid var(--navy);
  }
  .visit li {
    counter-increment: visit;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    column-gap: 1rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line);
  }
  .visit li::before {
    content: counter(visit);
    grid-row: span 2;
    font-family: var(--display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
    color: var(--red);
  }
  .visit li:nth-child(even)::before {
    color: var(--blue);
  }
  .visit h3 {
    font-size: 1.15rem;
    line-height: 1.25;
    margin-bottom: 0.35rem;
  }
  .visit p {
    color: var(--ink-soft);
  }

  /* ---------- Services: two photo panels ---------- */
  .svc {
    background: var(--wash);
  }
  .svc-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .svc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .svc-panel {
    background: var(--white);
    display: flex;
    flex-direction: column;
    box-shadow: 0 18px 40px -28px rgb(16 35 63 / 0.45);
  }
  .svc-photo {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .svc-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.8s var(--ease);
  }
  .svc-panel:hover .svc-photo img {
    scale: 1.04;
  }
  .svc-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem clamp(1.25rem, 2.5vw, 2rem);
    color: var(--white);
  }
  .svc-heat .svc-head {
    background: var(--red);
  }
  .svc-cool .svc-head {
    background: var(--blue);
  }
  .svc-head :global(svg) {
    width: 1.9rem;
    height: 1.9rem;
  }
  .svc-head h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  }
  .svc-head a {
    text-decoration: none;
  }
  .svc-items {
    list-style: none;
    margin: 0;
    padding: 0.5rem clamp(1.25rem, 2.5vw, 2rem) 0;
    display: grid;
  }
  .svc-items li {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.9rem;
    align-items: center;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .svc-items li:last-child {
    border-bottom: 0;
  }
  .svc-ico {
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    box-shadow: inset 0 0 0 2px currentColor;
  }
  .svc-heat .svc-ico {
    color: var(--red);
  }
  .svc-cool .svc-ico {
    color: var(--blue);
  }
  .svc-ico :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .svc-items strong {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.25;
  }
  .svc-items li span:last-child {
    color: var(--ink-soft);
    font-size: 0.97rem;
    line-height: 1.45;
  }
  .svc-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: auto clamp(1.25rem, 2.5vw, 2rem) 1.6rem;
    padding-top: 1rem;
    font-weight: 700;
    color: var(--ink);
  }
  .svc-heat .svc-more :global(svg) {
    color: var(--red);
  }
  .svc-cool .svc-more :global(svg) {
    color: var(--blue);
  }
  .svc-more :global(svg) {
    width: 1.05em;
    height: 1.05em;
    transition: transform 0.3s var(--ease);
  }
  .svc-more:hover :global(svg) {
    transform: translateX(4px);
  }
  .svc-wide {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem 1.75rem;
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    padding: clamp(1.4rem, 2.5vw, 2rem);
    background: var(--white);
    box-shadow: 0 18px 40px -28px rgb(16 35 63 / 0.45);
  }
  .svc-wide-ico {
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: var(--white);
  }
  .svc-wide-ico :global(svg) {
    width: 1.7rem;
    height: 1.7rem;
  }
  .svc-wide h3 {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    margin-bottom: 0.35rem;
  }
  .svc-wide h3 a {
    text-decoration: none;
  }
  .svc-wide p {
    color: var(--ink-soft);
  }

  /* ---------- Reviews ---------- */
  .reviews-in {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
  }
  .reviews h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
  }
  .reviews p {
    color: var(--ink-soft);
    font-size: 1.125rem;
    max-width: 36rem;
  }
  .reviews-act {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  /* ---------- FAQ ---------- */
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .faq h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
  }
  .faq-list {
    border-top: 3px solid var(--navy);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-weight: 750;
    font-size: 1.1rem;
    text-wrap: pretty;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--red);
    transition: rotate 0.3s var(--ease);
  }
  details[open] summary::after {
    rotate: 45deg;
  }
  details p {
    padding: 0 0 1.4rem;
    color: var(--ink-soft);
    max-width: 44rem;
  }

  /* ---------- Small screens ---------- */
  @media (max-width: 960px) {
    .owner-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .trust-list {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .hero-actions .btn {
      width: 100%;
    }
    .svc-wide {
      grid-template-columns: 1fr;
    }
    .pm-go {
      margin-left: 0;
    }
    .svc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
