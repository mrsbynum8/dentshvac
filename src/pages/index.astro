---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import QuoteCard from '../components/QuoteCard.astro';
import CallBand from '../components/CallBand.astro';
import { BRAND, GOOGLE, SERVICES, FAQS } from '../data/site';

type IconName = 'flame' | 'snowflake' | 'settings' | 'layers' | 'thermometer' | 'droplets';
const panels: { tone: string; title: string; href: string; img: string; alt: string; items: { icon: IconName; t: string }[] }[] = [
  {
    tone: 'heat', title: 'Heating', href: '/services/heating',
    img: '/photos/furnace.webp', alt: 'A modern gas furnace with vent pipes and ductwork in a basement',
    items: [
      { icon: 'flame', t: 'Furnace and heat repair' },
      { icon: 'settings', t: 'Furnace tune-ups and cleaning' },
      { icon: 'layers', t: 'Furnace and heat pump installs' },
      { icon: 'thermometer', t: 'Thermostats and wiring' },
    ],
  },
  {
    tone: 'cool', title: 'Cooling', href: '/services/cooling',
    img: '/photos/ac.webp', alt: 'An outdoor air conditioning condenser beside a red-brick house',
    items: [
      { icon: 'snowflake', t: 'AC repair' },
      { icon: 'settings', t: 'AC tune-ups and cleaning' },
      { icon: 'layers', t: 'New AC and heat pump systems' },
      { icon: 'droplets', t: 'Leak checks and refrigerant' },
    ],
  },
];
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Dent's Heating And Cooling | Furnace & AC Repair in St. Louis"
  description="No heat? No AC? Call Gerald Pickett, the owner of Dent's Heating And Cooling, for furnace and AC repair, installs and tune-ups in St. Louis and North County. 314-420-7803."
  schema={[faqSchema]}
>
  
  <section class="hero" aria-labelledby="hero-title">
    <picture class="hero-photo">
      <source media="(max-width: 767px)" srcset="/photos/hero-dusk-900.webp" />
      <img
        src="/photos/hero-dusk.webp"
        alt="A red-brick St. Louis home at dusk with glowing windows, the Gateway Arch in the distance"
        width="2000"
        height="667"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-copy">
      <h1 id="hero-title">Heating and AC repair in St.&nbsp;Louis, from the owner himself.</h1>
      <p class="hero-sub">Gerald Pickett answers, diagnoses your system, and does the work.</p>
      <a class="btn btn-red hero-call" href={BRAND.phoneHref}><Icon name="phone" /> Call {BRAND.phone}</a>
    </div>
    <div class="hero-form" id="request">
      <QuoteCard id="hero" />
    </div>
  </section>

  <section class="trust" aria-label="Why people call Dent's">
    <ul class="wrap trust-list">
      <li><Icon name="wrench" /><span>The owner does the work</span></li>
      <li><Icon name="tag" /><span>Price before any work</span></li>
      <li><Icon name="building" /><span>Homes and multifamily</span></li>
    </ul>
  </section>

  <section class="svc" aria-label="Heating and cooling services">
    <div class="wrap svc-grid">
      {panels.map((pn) => (
        <article class={`svc-panel svc-${pn.tone}`}>
          <h2 class="svc-bar"><a href={pn.href}>{pn.title}</a></h2>
          <div class="svc-body">
            <img class="svc-photo" src={pn.img} alt={pn.alt} width="1100" height="733" loading="lazy" />
            <div class="svc-side">
              <ul class="svc-items">
                {pn.items.map((it) => (
                  <li><Icon name={it.icon} /><span>{it.t}</span></li>
                ))}
              </ul>
              <a class="svc-more" href={pn.href}>All {pn.title.toLowerCase()} services <Icon name="arrow" /></a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="reviews" aria-label="Reviews">
    <div class="wrap reviews-in">
      <a class="reviews-read" href={GOOGLE.reviewsUrl} target="_blank" rel="noopener">Read Gerald's reviews on Google <Icon name="arrow" /></a>
      <span class="reviews-sep" aria-hidden="true"></span>
      <a class="reviews-write" href={GOOGLE.writeReviewUrl} target="_blank" rel="noopener">Worked with Gerald? Leave a review</a>
    </div>
  </section>

  <section class="owner section">
    <div class="wrap owner-grid">
      <div class="owner-copy">
        <h2>One owner. He picks up, and he does the work.</h2>
        <p>
          Dent's Heating And Cooling is {BRAND.owner}. When you call, you're talking to the person who will diagnose your system and
          fix it: no sales team, no hand-offs, no upsell script. If he's mid-job, the line takes your details so the call never goes to
          voicemail.
        </p>
        <p>He works on homes across {BRAND.area}, and on apartment and multifamily properties for the managers who run them.</p>
        <a class="link-arrow" href="/about">More about Gerald <Icon name="arrow" /></a>
      </div>
      <ol class="visit">
        <li>
          <h3>You call or send a request</h3>
          <p>Tell Gerald what the system is doing. Texting the details works too.</p>
        </li>
        <li>
          <h3>Gerald comes out and finds the problem</h3>
          <p>A proper diagnosis first, so you pay for the fix you need.</p>
        </li>
        <li>
          <h3>You get the price before any work</h3>
          <p>Part prices move, so he checks today's supplier cost and calls you with the number.</p>
        </li>
        <li>
          <h3>It gets fixed, start to finish</h3>
          <p>Gerald does the repair himself, so the person who found the problem is the one who fixes it.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="tune">
    <div class="wrap tune-in">
      <img class="tune-photo" src="/photos/tuneup.webp" alt="Service gauges connected to an outdoor air conditioner" width="1100" height="733" loading="lazy" />
      <div>
        <h2><a href="/services/maintenance">Tune-ups before each season</a></h2>
        <p>A spring AC check and a fall furnace check catch the cheap problems before they become the expensive ones. You'll get a reminder every spring.</p>
        <a class="btn btn-line" href="/services/maintenance">Book a tune-up <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <a class="pm-bar" href="/services/property-management">
    <span class="pm-bar-in">
      <Icon name="building" />
      <strong>Property manager or landlord?</strong>
      <span>Units down across a building? Send the property and the unit, and Gerald will take it from there.</span>
      <span class="pm-go">Property service <Icon name="arrow" /></span>
    </span>
  </a>

  <CallBand />

  <section class="faq section">
    <div class="wrap faq-grid">
      <h2>Straight answers</h2>
      <div class="faq-list">
        {FAQS.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero: dusk photo under a navy tint, copy left, quote card right ---------- */
  .hero {
    position: relative;
    color: var(--white);
    background: var(--navy);
    overflow: hidden;
  }
  .hero-photo,
  .hero-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-photo img {
    object-fit: cover;
    object-position: 38% center;
  }
  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(10 22 44 / 0.92) 0%, rgb(10 22 44 / 0.78) 34%, rgb(10 22 44 / 0.25) 62%, rgb(10 22 44 / 0.1) 100%);
  }
  .hero-copy,
  .hero-form {
    position: relative;
    z-index: 1;
  }
  .hero-copy {
    padding: clamp(2.5rem, 7vw, 4rem) var(--gutter) 1.5rem;
  }
  .hero h1 {
    font-size: clamp(2.3rem, 4.6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 16ch;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.35);
  }
  .hero-sub {
    margin-top: clamp(1rem, 1.6vw, 1.5rem);
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    line-height: 1.4;
    max-width: 28rem;
    color: var(--white);
  }
  .hero-call {
    margin-top: clamp(1.5rem, 2.4vw, 2.25rem);
    min-height: 64px;
    padding-inline: 1.75rem;
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
  }
  .hero-form {
    padding: 0 var(--gutter) 2.5rem;
  }
  .hero-form :global(.qc) {
    color: var(--ink);
    box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.6);
  }
  @media (min-width: 960px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(400px, 37vw, 560px);
      gap: clamp(2rem, 4vw, 4rem);
      align-items: center;
      padding: clamp(2rem, 3vw, 2.75rem) var(--gutter);
      min-height: min(640px, calc(100svh - var(--header-h) - 96px));
    }
    .hero-copy,
    .hero-form {
      padding: 0;
    }
  }
  @media (min-width: 1180px) {
    .hero-form :global(.qc-fields) {
      grid-template-columns: 1.1fr 1.1fr 0.8fr;
    }
    .hero-form :global(.qc-wide) {
      grid-column: auto;
    }
  }
  @media (min-width: 1600px) {
    .hero {
      padding-inline: calc((100vw - 1500px) / 2);
    }
  }

  /* ---------- Trust bar (from mockup 1) ---------- */
  .trust {
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }
  .trust-list {
    list-style: none;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding-block: clamp(1.25rem, 2.2vw, 1.75rem);
  }
  .trust li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline: clamp(1rem, 2.5vw, 2rem);
  }
  .trust li + li {
    border-left: 1px solid var(--line);
  }
  .trust li:first-child {
    padding-left: 0;
  }
  .trust li :global(svg) {
    width: clamp(2.4rem, 3.4vw, 3rem);
    height: clamp(2.4rem, 3.4vw, 3rem);
    flex: none;
    color: var(--blue);
    stroke-width: 1.6;
  }
  .trust li span {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.1rem, 1.7vw, 1.5rem);
    line-height: 1.15;
    max-width: 12ch;
  }

  /* ---------- Property manager lane ---------- */
  .pm-bar {
    display: block;
    background: var(--navy);
    color: var(--white);
    text-decoration: none;
  }
  .pm-bar-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.25rem;
    max-width: 1440px;
    margin-inline: auto;
    min-height: 64px;
    padding: 0.9rem var(--gutter);
  }
  .pm-bar-in > :global(svg:first-child) {
    width: 1.6rem;
    height: 1.6rem;
    color: #ff8fa3;
  }
  .pm-bar strong {
    font-family: var(--display);
    font-weight: 700;
  }
  .pm-bar-in > span:not(.pm-go) {
    color: #c9d6e8;
  }
  .pm-go {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .pm-go :global(svg) {
    width: 1.05em;
    height: 1.05em;
    transition: transform 0.3s var(--ease);
  }
  .pm-bar:hover .pm-go :global(svg) {
    transform: translateX(4px);
  }

  /* ---------- Owner ---------- */
  .owner-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .owner h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    margin-bottom: 1.5rem;
  }
  .owner-copy p {
    color: var(--ink-soft);
    font-size: 1.125rem;
    margin-bottom: 1.1rem;
  }
  .owner-copy .link-arrow {
    margin-top: 0.5rem;
  }
  .visit {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: visit;
    border-top: 3px solid var(--navy);
  }
  .visit li {
    counter-increment: visit;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    column-gap: 1rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line);
  }
  .visit li::before {
    content: counter(visit);
    grid-row: span 2;
    font-family: var(--display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
    color: var(--red);
  }
  .visit li:nth-child(even)::before {
    color: var(--blue);
  }
  .visit h3 {
    font-size: 1.15rem;
    line-height: 1.25;
    margin-bottom: 0.35rem;
  }
  .visit p {
    color: var(--ink-soft);
  }

  /* ---------- Heating | Cooling panels (approved mockup) ---------- */
  .svc {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.25rem);
  }
  .svc .wrap {
    max-width: 1440px;
  }
  .svc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .svc-panel {
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
  }
  .svc-bar {
    padding: 0.85rem clamp(1.1rem, 2vw, 1.6rem);
    font-size: clamp(1.9rem, 3.2vw, 2.9rem);
    line-height: 1.05;
    color: var(--white);
  }
  .svc-heat .svc-bar {
    background: var(--red);
  }
  .svc-cool .svc-bar {
    background: var(--blue);
  }
  .svc-bar a {
    text-decoration: none;
  }
  .svc-body {
    display: grid;
    grid-template-columns: 46% 1fr;
    flex: 1;
  }
  .svc-photo {
    width: 100%;
    height: 100%;
    min-height: 240px;
    object-fit: cover;
  }
  .svc-side {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    padding: clamp(1.1rem, 2vw, 1.6rem);
  }
  .svc-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.95rem;
  }
  .svc-items li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 0.75rem;
    align-items: center;
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.3;
  }
  .svc-items :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    stroke-width: 1.75;
  }
  .svc-heat .svc-items li:first-child :global(svg) {
    color: var(--red);
  }
  .svc-cool .svc-items li:first-child :global(svg) {
    color: var(--blue);
  }
  .svc-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    color: var(--ink);
  }
  .svc-more :global(svg) {
    width: 1.05em;
    height: 1.05em;
    transition: transform 0.3s var(--ease);
  }
  .svc-heat .svc-more :global(svg) {
    color: var(--red);
  }
  .svc-cool .svc-more :global(svg) {
    color: var(--blue);
  }
  .svc-more:hover :global(svg) {
    transform: translateX(4px);
  }

  /* ---------- Reviews line ---------- */
  .reviews-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    padding-block: clamp(1rem, 2vw, 1.5rem) clamp(3rem, 6vw, 4.5rem);
  }
  .reviews-read {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.85rem);
    text-decoration: none;
    color: var(--ink);
  }
  .reviews-read :global(svg) {
    width: 0.85em;
    height: 0.85em;
    color: var(--red);
    transition: transform 0.3s var(--ease);
  }
  .reviews-read:hover :global(svg) {
    transform: translateX(5px);
  }
  .reviews-sep {
    width: 1px;
    height: 2rem;
    background: var(--line);
  }
  .reviews-write {
    color: var(--ink-soft);
  }

  /* ---------- Tune-ups ---------- */
  .tune {
    background: var(--wash);
  }
  .tune-in {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .tune-photo {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .tune h2 {
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    margin-bottom: 0.75rem;
  }
  .tune h2 a {
    text-decoration: none;
  }
  .tune p {
    color: var(--ink-soft);
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
    max-width: 34rem;
  }

  /* ---------- FAQ ---------- */
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .faq h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
  }
  .faq-list {
    border-top: 3px solid var(--navy);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    font-weight: 750;
    font-size: 1.1rem;
    text-wrap: pretty;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--red);
    transition: rotate 0.3s var(--ease);
  }
  details[open] summary::after {
    rotate: 45deg;
  }
  details p {
    padding: 0 0 1.4rem;
    color: var(--ink-soft);
    max-width: 44rem;
  }

  /* ---------- Small screens ---------- */
  @media (max-width: 960px) {
    .owner-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
    .svc-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .hero-photo::after {
      background: linear-gradient(180deg, rgb(10 22 44 / 0.3) 0%, rgb(10 22 44 / 0.7) 32%, rgb(10 22 44 / 0.94) 60%);
    }
    .hero-call {
      width: 100%;
    }
    .trust-list {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .trust li,
    .trust li:first-child {
      padding: 0;
    }
    .trust li + li {
      border-left: 0;
    }
    .trust li span {
      max-width: none;
    }
    .svc-body {
      grid-template-columns: 1fr;
    }
    .svc-photo {
      aspect-ratio: 16 / 9;
      height: auto;
    }
    .tune-in {
      grid-template-columns: 1fr;
    }
    .reviews-sep {
      display: none;
    }
    .pm-go {
      margin-left: 0;
    }
  }
</style>
