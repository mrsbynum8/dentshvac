---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import QuoteCard from '../../components/QuoteCard.astro';
import CallBand from '../../components/CallBand.astro';
import { BRAND, SERVICES, type Service } from '../../data/site';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service } = Astro.props as { service: Service };
const site = Astro.site!.origin;
const isPM = service.slug === 'property-management';

type IconName = 'flame' | 'thermometer' | 'fan' | 'zap' | 'house' | 'wind' | 'snowflake' | 'gauge' | 'droplets' | 'wrench' | 'calendar' | 'vent' | 'check';
interface Visual {
  hero: string; heroAlt: string; side: string; sideAlt: string; preset: string; icon: IconName;
  items: { icon: IconName; t: string; d: string }[];
}
// Photos are generated illustrations (no people); provenance sidecars live beside each file in public/photos.
const VISUALS: Record<string, Visual> = {
  heating: {
    hero: '/photos/furnace.webp', heroAlt: 'A modern gas furnace with vent pipes and ductwork in a basement',
    side: '/photos/thermostat.webp', sideAlt: 'A digital thermostat on a living-room wall',
    preset: 'No heat', icon: 'flame',
    items: [
      { icon: 'flame', t: 'Gas furnace repair', d: 'Control boards, pressure and high-limit switches, blower motors' },
      { icon: 'zap', t: 'Ignition problems', d: 'Flame sensors cleaned, igniters checked' },
      { icon: 'wrench', t: 'Electric furnaces', d: 'Sequencers and heat kits' },
      { icon: 'house', t: 'Furnace replacement', d: '60,000 to 100,000 BTU, with the permit pulled' },
      { icon: 'fan', t: 'Heat pumps', d: 'Service and installation' },
      { icon: 'thermometer', t: 'Thermostats', d: 'New installs and wiring conversions' },
    ],
  },
  cooling: {
    hero: '/photos/ac.webp', heroAlt: 'An outdoor air conditioning condenser beside a red-brick house',
    side: '/photos/thermostat.webp', sideAlt: 'A digital thermostat on a living-room wall',
    preset: 'No AC', icon: 'snowflake',
    items: [
      { icon: 'snowflake', t: 'AC repair', d: 'Capacitors, contactors, condenser fan motors, transformers' },
      { icon: 'droplets', t: 'Leak checks', d: 'Refrigerant leak diagnostics and system inspections' },
      { icon: 'gauge', t: 'Refrigerant service', d: 'R-410A and R-454B systems' },
      { icon: 'vent', t: 'New AC systems', d: 'Condensers (2 to 4 ton), line sets and disconnects' },
      { icon: 'wind', t: 'Air handlers', d: 'Blowers, A-coils and filter racks' },
      { icon: 'calendar', t: 'Spring tune-ups', d: 'Before the first hot week, not during it' },
    ],
  },
  maintenance: {
    hero: '/photos/tuneup.webp', heroAlt: 'Service gauges connected to an outdoor air conditioner',
    side: '/photos/furnace.webp', sideAlt: 'A modern gas furnace in a basement',
    preset: 'Tune-up', icon: 'calendar',
    items: [
      { icon: 'snowflake', t: 'Spring AC tune-up', d: 'Cleaning, contactor check and amp-draw readings' },
      { icon: 'flame', t: 'Fall furnace tune-up', d: 'Burner check and flame sensor cleaning' },
      { icon: 'zap', t: 'Electric furnace check', d: 'Sequencers and heat kits tested' },
      { icon: 'wind', t: 'Filters and airflow', d: 'Filters checked, airflow problems caught early' },
      { icon: 'calendar', t: 'A yearly reminder', d: 'A reminder every spring so it never slips' },
    ],
  },
  'property-management': {
    hero: '/photos/apartments.webp', heroAlt: 'A brick apartment building with outdoor air conditioning units',
    side: '/photos/ac.webp', sideAlt: 'An outdoor air conditioning condenser beside a brick building',
    preset: 'Property unit', icon: 'house',
    items: [
      { icon: 'house', t: 'Apartments and rentals', d: 'Heating and cooling repair, unit by unit' },
      { icon: 'wrench', t: 'Fixed on the spot', d: 'When the part is already on the truck' },
      { icon: 'gauge', t: 'Parts ordered fast', d: 'Supply-house pricing, return visit scheduled with you' },
      { icon: 'calendar', t: 'Seasonal maintenance', d: 'Tune-ups across a whole property' },
    ],
  },
};
const v = VISUALS[service.slug];
const others = SERVICES.filter((s) => s.slug !== service.slug);
const schema = [
  {
    '@type': 'Service',
    name: service.h1,
    serviceType: service.nav,
    provider: { '@id': `${site}/#business` },
    areaServed: 'St. Louis, MO',
    description: service.description,
  },
  {
    '@type': 'FAQPage',
    mainEntity: service.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: service.nav, item: `${site}/services/${service.slug}` },
    ],
  },
];
---
<Base title={service.title} description={service.description} schema={schema}>
  <section class={`sh tone-${service.tone}`} aria-labelledby="sh-title">
    <picture class="sh-photo">
      <img src={v.hero} alt={v.heroAlt} width="1100" height="733" fetchpriority="high" />
    </picture>
    <div class="sh-copy">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> {service.nav}</nav>
      <h1 id="sh-title">{service.h1}</h1>
      <p class="sh-lead">{service.lead}</p>
      <div class="sh-actions">
        <a class="btn btn-red btn-lg" href={BRAND.phoneHref}><Icon name="phone" /> Call {BRAND.phone}</a>
        {isPM && <a class="btn btn-line btn-lg" href="/pm-request">Full property request</a>}
      </div>
    </div>
    <div class="sh-form"><QuoteCard id={service.slug} source={`Website ${service.nav} Page`} preset={v.preset} /></div>
  </section>

  <section class={`handles section tone-${service.tone}`}>
    <div class="wrap">
      <h2>What Gerald handles</h2>
      <ul class="hl-grid">
        {v.items.map((it) => (
          <li>
            <span class="hl-ico"><Icon name={it.icon} /></span>
            <span><strong>{it.t}</strong>{it.d}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="signs section">
    <div class="wrap signs-grid">
      <figure class="signs-photo">
        <img src={v.side} alt={v.sideAlt} width="1100" height="733" loading="lazy" />
      </figure>
      <div>
        <h2>{service.signs.heading === 'Call when' ? 'Call Gerald when' : service.signs.heading}</h2>
        <ul class="signs-list">
          {service.signs.items.map((i) => <li><Icon name="arrow" /><span>{i}</span></li>)}
        </ul>
        <div class="price">
          <span class="price-ico"><Icon name="gauge" /></span>
          <div>
            <h3>How pricing works</h3>
            <p>
              {isPM
                ? 'Each repair is diagnosed first. When the part is on the truck, it’s fixed on the spot; when it isn’t, Gerald gets supply-house pricing, orders it, and schedules the return with your office.'
                : 'Part prices change with the supplier, so there’s no guessing over the phone. Gerald diagnoses the system, checks today’s price for the part, and calls you with the number before any work begins.'}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="faq section">
    <div class="wrap faq-grid">
      <h2>Questions people ask</h2>
      <div class="faq-list">
        {service.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CallBand />

  <nav class="more section" aria-label="Other services">
    <div class="wrap">
      <h2>Other services</h2>
      <div class="more-grid">
        {others.map((o) => (
          <a class="more-tile" href={`/services/${o.slug}`}>
            <img src={VISUALS[o.slug].hero} alt="" width="1100" height="733" loading="lazy" />
            <span class={`more-label tone-${o.tone}`}>{o.nav} <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </nav>
</Base>

<style>
  /* tone colours for accents */
  .tone-heat { --tone: var(--red); }
  .tone-cool { --tone: var(--blue); }
  .tone-split, .tone-navy { --tone: var(--navy); }

  /* ---------- Hero: photo under a navy tint, copy left, quote card right (same as home) ---------- */
  .sh {
    position: relative;
    color: var(--white);
    background: var(--navy);
    overflow: hidden;
  }
  .sh-photo,
  .sh-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .sh-photo img {
    object-fit: cover;
    object-position: 60% center;
  }
  .sh-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(10 22 44 / 0.92) 0%, rgb(10 22 44 / 0.8) 36%, rgb(10 22 44 / 0.3) 64%, rgb(10 22 44 / 0.15) 100%);
  }
  .sh-copy,
  .sh-form {
    position: relative;
    z-index: 1;
  }
  .sh-copy {
    padding: clamp(2.5rem, 7vw, 4rem) var(--gutter) 1.5rem;
  }
  .crumbs {
    font-size: 0.92rem;
    color: #c9d6e8;
    margin-bottom: 1rem;
  }
  .crumbs a {
    color: var(--white);
  }
  .sh h1 {
    font-size: clamp(2.1rem, 4vw, 3.8rem);
    line-height: 1.03;
    letter-spacing: -0.02em;
    max-width: 16ch;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.35);
  }
  .sh h1::after {
    content: '';
    display: block;
    width: 72px;
    height: 6px;
    margin-top: 1.1rem;
    background: var(--tone);
  }
  .tone-split h1::after,
  .tone-navy h1::after {
    background: linear-gradient(90deg, var(--red) 0 50%, var(--blue) 50% 100%);
  }
  .sh-lead {
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.5;
    color: var(--white);
    max-width: 34rem;
  }
  .sh-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .btn-lg {
    min-height: 60px;
    padding-inline: 1.6rem;
    font-size: 1.05rem;
  }
  .sh .btn-line {
    color: var(--white);
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.7);
  }
  .sh .btn-line:hover {
    background: var(--white);
    color: var(--navy);
  }
  .sh-form {
    padding: 0 var(--gutter) 2.5rem;
  }
  .sh-form :global(.qc) {
    color: var(--ink);
    box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.6);
  }
  @media (min-width: 960px) {
    .sh {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(400px, 37vw, 560px);
      gap: clamp(2rem, 4vw, 4rem);
      align-items: center;
      padding: clamp(2rem, 3vw, 2.75rem) var(--gutter);
      min-height: min(640px, calc(100svh - var(--header-h) - 40px));
    }
    .sh-copy,
    .sh-form {
      padding: 0;
    }
  }
  @media (min-width: 1180px) {
    .sh-form :global(.qc-fields) {
      grid-template-columns: 1.1fr 1.1fr 0.8fr;
    }
    .sh-form :global(.qc-wide) {
      grid-column: auto;
    }
  }
  @media (min-width: 1600px) {
    .sh {
      padding-inline: calc((100vw - 1500px) / 2);
    }
  }
  @media (max-width: 760px) {
    .sh-photo::after {
      background: linear-gradient(180deg, rgb(10 22 44 / 0.3) 0%, rgb(10 22 44 / 0.72) 34%, rgb(10 22 44 / 0.94) 60%);
    }
  }

  h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.75rem);
    margin-bottom: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  /* ---------- What Gerald handles: icon item grid ---------- */
  .handles {
    background: var(--wash);
  }
  .hl-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--line);
    box-shadow: 0 18px 40px -28px rgb(16 35 63 / 0.45);
  }
  .hl-grid li {
    flex: 1 1 calc(33.333% - 1px);
    min-width: min(100%, 300px);
    background: var(--white);
    padding: 1.6rem 1.5rem;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    align-items: start;
  }
  .hl-ico {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    color: var(--tone, var(--navy));
    box-shadow: inset 0 0 0 2px currentColor;
  }
  .hl-ico :global(svg) {
    width: 1.45rem;
    height: 1.45rem;
  }
  .hl-grid strong {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.1rem;
    line-height: 1.25;
    margin-bottom: 0.3rem;
  }
  .hl-grid li span:last-child {
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.45;
  }

  /* ---------- Call when: photo + list + pricing ---------- */
  .signs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .signs-photo {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .signs-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .signs-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    border-top: 3px solid var(--navy);
  }
  .signs-list li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.75rem;
    align-items: start;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.08rem;
  }
  .signs-list :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.2rem;
    color: var(--red);
  }
  .price {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--wash);
  }
  .price-ico {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: var(--white);
  }
  .price-ico :global(svg) {
    width: 1.45rem;
    height: 1.45rem;
  }
  .price h3 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }
  .price p {
    color: var(--ink-soft);
  }

  /* ---------- FAQ ---------- */
  .faq {
    padding-top: 0;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .faq-list {
    border-top: 3px solid var(--navy);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem 0;
    font-weight: 750;
    font-size: 1.08rem;
    text-wrap: pretty;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--red);
    transition: rotate 0.3s var(--ease);
  }
  details[open] summary::after {
    rotate: 45deg;
  }
  details p {
    padding-bottom: 1.3rem;
    color: var(--ink-soft);
  }

  /* ---------- Other services: photo tiles ---------- */
  .more-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .more-tile {
    display: block;
    text-decoration: none;
    background: var(--white);
    box-shadow: 0 18px 40px -28px rgb(16 35 63 / 0.45);
    overflow: hidden;
  }
  .more-tile img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: scale 0.8s var(--ease);
  }
  .more-tile:hover img {
    scale: 1.04;
  }
  .more-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--white);
    background: var(--tone);
  }
  .more-label :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.3s var(--ease);
  }
  .more-tile:hover .more-label :global(svg) {
    transform: translateX(5px);
  }

  @media (max-width: 1000px) {
    .hl-grid li {
      flex-basis: calc(50% - 1px);
    }
  }
  @media (max-width: 900px) {
    .signs-grid,
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .more-grid {
      grid-template-columns: 1fr;
    }
    .hl-grid li {
      flex-basis: 100%;
    }
    .sh-actions .btn {
      width: 100%;
    }
  }
</style>
