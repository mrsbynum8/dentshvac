---
import Icon from './Icon.astro';
import { BRAND, NAV } from '../data/site';
interface Props { bare?: boolean }
const { bare = false } = Astro.props;
const here = Astro.url.pathname.replace(/\.html$/, '');
---
<header class="hdr">
  <div class="hdr-in">
    <a class="hdr-logo" href="/" aria-label={`${BRAND.name} home`}>
      <img src="/brand/logo-dark.webp" alt={BRAND.name} width="1745" height="316" />
    </a>
    {!bare && (
      <nav class="hdr-nav" aria-label="Main">
        <ul>
          {NAV.map((n) => (
            <li><a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <a class="hdr-call" href={BRAND.phoneHref}>
      <Icon name="phone" />
      <span class="hdr-call-num">{BRAND.phone}</span>
      <span class="sr-only">Call {BRAND.short}</span>
    </a>
    {!bare && (
      <details class="hdr-menu">
        <summary aria-label="Menu"><Icon name="menu" /><span>Menu</span></summary>
        <div class="hdr-sheet">
          <ul>
            <li><a href="/">Home</a></li>
            {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            <li><a href="/request-service">Request Service</a></li>
            <li><a href="/pm-request">Property Request</a></li>
          </ul>
          <a class="btn btn-red" href={BRAND.phoneHref}><Icon name="phone" /> Call {BRAND.phone}</a>
        </div>
      </details>
    )}
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--white);
    box-shadow: 0 1px 0 var(--line);
  }
  .hdr-in {
    height: var(--header-h);
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .hdr-logo img {
    width: clamp(150px, 16vw, 210px);
    height: auto;
  }
  .hdr-nav {
    margin-left: auto;
  }
  .hdr-nav ul {
    display: flex;
    gap: clamp(1rem, 1.8vw, 1.9rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hdr-nav a {
    text-decoration: none;
    font-weight: 650;
    font-size: 0.95rem;
    padding-block: 0.4rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .hdr-nav a:hover,
  .hdr-nav a[aria-current='page'] {
    border-color: var(--red);
  }
  .hdr-call {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 48px;
    padding: 0 1.1rem;
    background: var(--navy);
    color: var(--white);
    text-decoration: none;
    font-stretch: var(--wide);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    transition: background-color 0.25s var(--ease);
  }
  .hdr-call:hover {
    background: var(--red);
  }
  .hdr-call :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .bare .hdr-call {
    margin-left: auto;
  }
  .hdr-menu {
    display: none;
  }
  .hdr-menu summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 48px;
    padding: 0 0.85rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: inset 0 0 0 2px var(--navy);
  }
  .hdr-menu summary::-webkit-details-marker {
    display: none;
  }
  .hdr-menu summary :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .hdr-sheet {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--header-h);
    background: var(--white);
    padding: 1rem var(--gutter) 1.5rem;
    box-shadow: 0 18px 30px -12px rgb(16 35 63 / 0.25);
  }
  .hdr-sheet ul {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  .hdr-sheet li a {
    display: block;
    padding: 0.85rem 0;
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: 1.15rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .hdr-sheet .btn {
    width: 100%;
  }

  @media (max-width: 1100px) {
    .hdr-nav {
      display: none;
    }
    .hdr-call {
      margin-left: auto;
    }
    .hdr-menu {
      display: block;
    }
  }
  @media (max-width: 560px) {
    .hdr-in {
      gap: 0.6rem;
    }
    .hdr-call-num {
      display: none;
    }
    .hdr-call {
      padding: 0 0.9rem;
    }
    .hdr-menu summary span {
      display: none;
    }
  }
</style>
