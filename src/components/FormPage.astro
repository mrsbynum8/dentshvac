---
// Form-first layout for request pages: the form starts at the top of the page.
// Left: a compact photo panel (title, points, call) that stays in view; right: the form.
import Icon from './Icon.astro';
import GhlForm from './GhlForm.astro';
import { BRAND } from '../data/site';
interface Props {
  title: string; lead: string; img: string; alt: string; crumb: string;
  form: { id: string; name: string; height: number; desktop: number; mobile: number };
  points?: { icon: 'building' | 'wrench' | 'calendar' | 'flame' | 'snowflake' | 'check'; t: string }[];
  call?: string;
}
const { title, lead, img, alt, crumb, form, points = [], call = 'Call' } = Astro.props;
---
<section class="fp">
  <div class="fp-in">
    <aside class="fp-info">
      <img class="fp-photo" src={img} alt={alt} width="1100" height="733" />
      <div class="fp-copy">
        <nav class="fp-crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> {crumb}</nav>
        <h1>{title}</h1>
        <p class="fp-lead">{lead}</p>
        {points.length > 0 && (
          <ul class="fp-points">
            {points.map((pt) => <li><Icon name={pt.icon} /><span>{pt.t}</span></li>)}
          </ul>
        )}
        <a class="btn btn-red fp-call" href={BRAND.phoneHref}><Icon name="phone" /> {call} {BRAND.phone}</a>
      </div>
    </aside>
    <div class="fp-form">
      <GhlForm form={form} />
    </div>
  </div>
</section>

<style>
  .fp {
    background: var(--wash);
    padding: clamp(1.25rem, 3vw, 2.5rem) 0 clamp(3rem, 6vw, 4.5rem);
  }
  .fp-in {
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: minmax(300px, 0.85fr) minmax(0, 1.4fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }
  .fp-info {
    position: sticky;
    top: calc(var(--header-h) + 1.25rem);
    overflow: hidden;
    color: var(--white);
    background: var(--navy);
    isolation: isolate;
  }
  .fp-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .fp-info::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(10 22 44 / 0.55) 0%, rgb(10 22 44 / 0.88) 45%, rgb(10 22 44 / 0.95) 100%);
  }
  .fp-copy {
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
  }
  .fp-crumbs {
    font-size: 0.9rem;
    color: #c9d6e8;
    margin-bottom: 0.9rem;
  }
  .fp-crumbs a {
    color: var(--white);
  }
  h1 {
    font-size: clamp(1.8rem, 2.6vw, 2.6rem);
    line-height: 1.05;
  }
  h1::after {
    content: '';
    display: block;
    width: 64px;
    height: 5px;
    margin-top: 0.9rem;
    background: linear-gradient(90deg, var(--red) 0 50%, var(--blue) 50% 100%);
  }
  .fp-lead {
    margin-top: 1rem;
    line-height: 1.5;
  }
  .fp-points {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .fp-points li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.65rem;
    align-items: center;
    font-family: var(--display);
    font-weight: 600;
  }
  .fp-points :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
    color: #a9c8ec;
  }
  .fp-call {
    margin-top: 1.5rem;
    width: 100%;
  }
  .fp-form {
    background: var(--white);
    padding: clamp(0.5rem, 1.5vw, 1.25rem);
    box-shadow: 0 18px 40px -28px rgb(16 35 63 / 0.45);
  }
  @media (max-width: 900px) {
    .fp-in {
      grid-template-columns: 1fr;
    }
    .fp-info {
      position: relative;
      top: 0;
    }
    .fp-points {
      display: none;
    }
  }
</style>
