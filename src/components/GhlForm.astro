---
import { GHL } from '../data/site';
interface Props { form: { id: string; name: string; height: number; desktop: number; mobile: number } }
const { form } = Astro.props;
---
<div class="ghl" style={`--h:${form.desktop}px;--hm:${form.mobile}px`}>
  <p class="ghl-loading">Loading the request form… If it doesn't appear, call 314-420-7803.</p>
  <iframe
    src={`https://brand.dentsheatingandcooling.com/widget/form/${form.id}`}
    style="width:100%;border:none"
    id={`inline-${form.id}`}
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name={form.name}
    data-height={String(Math.max(form.desktop, form.mobile))}
    data-layout-iframe-id={`inline-${form.id}`}
    data-form-id={form.id}
    title={form.name}
    loading="lazy"
    onload="this.previousElementSibling.hidden=true"
  ></iframe>
</div>
<script is:inline src={GHL.formEmbedScript} defer></script>

<style>
  .ghl {
    position: relative;
    background: transparent;
  }
  .ghl iframe {
    position: relative;
    z-index: 1;
    display: block;
    height: var(--h) !important;
  }
  @media (max-width: 640px) {
    .ghl iframe {
      height: var(--hm) !important;
    }
  }
  .ghl-loading {
    position: absolute;
    inset: 2rem 1rem auto;
    text-align: center;
    color: var(--ink-soft);
  }
</style>
