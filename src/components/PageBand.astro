---
interface Props { title: string; lead?: string; tone?: 'heat' | 'cool' | 'navy' }
const { title, lead, tone = 'navy' } = Astro.props;
---
<section class={`pb pb-${tone}`}>
  <div class="wrap pb-in">
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .pb {
    color: var(--white);
  }
  .pb-heat {
    background: var(--red);
  }
  .pb-cool {
    background: var(--blue);
  }
  .pb-navy {
    background: var(--navy);
  }
  .pb-in {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  h1 {
    font-size: clamp(2.3rem, 5vw, 4.5rem);
    max-width: 16ch;
    margin-bottom: 1.1rem;
  }
  p {
    font-size: clamp(1.08rem, 1.5vw, 1.3rem);
    max-width: 40rem;
    color: var(--white);
  }
</style>
